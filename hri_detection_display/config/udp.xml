<?xml version="1.0" encoding="UTF-8" ?>
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
    <profiles>
        <transport_descriptors>
            <!-- Only UDP to send compressed images over WiFi -->
            <transport_descriptor>
                <transport_id>transport</transport_id>
                <type>UDPv4</type>
                <non_blocking_send>true</non_blocking_send>
                <sendBufferSize>580000</sendBufferSize>
                <receiveBufferSize>580000</receiveBufferSize>
            </transport_descriptor>
        </transport_descriptors>

        <participant profile_name="image_receptor" is_default_profile="true">
            <rtps>
                <name>profile_for_ros2_context</name>
                <userTransports>
                    <transport_id>transport</transport_id>
                </userTransports>
                <!-- This ID will use the port 7632 -->
                <participantID>111</participantID>
                <useBuiltinTransports>false</useBuiltinTransports>
                <!-- Sockets Size -->
                <sendSocketBufferSize>580000</sendSocketBufferSize>
                <listenSocketBufferSize>580000</listenSocketBufferSize>

                <defaultUnicastLocatorList>
                    <locator>
                        <udpv4>
                            <address>192.168.77.5</address>
                            <port>7632</port>
                        </udpv4>
                    </locator>
                </defaultUnicastLocatorList>

                <builtin>
                    <metatrafficUnicastLocatorList>
                        <locator>
                            <udpv4>
                                <address>192.168.77.5</address>
                                <port>7632</port>
                            </udpv4>
                        </locator>
                    </metatrafficUnicastLocatorList>
                </builtin>

            </rtps>
        </participant>
    </profiles>
</dds>
