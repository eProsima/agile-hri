<?xml version="1.0" encoding="UTF-8" ?>
<dds xmlns="http://www.eprosima.com">
    <profiles>
        <transport_descriptors>
            <!-- Only TCP to send images over WiFi -->
            <transport_descriptor>
                <transport_id>tcp_transport</transport_id>
                <type>TCPv4</type>
                <listening_ports>
                    <port>42100</port>
                </listening_ports>
                <calculate_crc>false</calculate_crc>
                <check_crc>false</check_crc>
                <enable_tcp_nodelay>true</enable_tcp_nodelay>
                <non_blocking_send>false</non_blocking_send>
                <sendBufferSize>580000</sendBufferSize>
                <receiveBufferSize>580000</receiveBufferSize>
            </transport_descriptor>
        </transport_descriptors>

        <participant profile_name="image_receptor" is_default_profile="true">
            <rtps>
                <name>profile_for_ros2_context</name>
                <userTransports>
                    <transport_id>tcp_transport</transport_id>
                </userTransports>
                <useBuiltinTransports>false</useBuiltinTransports>
                <!-- Sockets Size -->
                <sendSocketBufferSize>580000</sendSocketBufferSize>
                <listenSocketBufferSize>580000</listenSocketBufferSize>
            </rtps>
        </participant>
    </profiles>
</dds>
