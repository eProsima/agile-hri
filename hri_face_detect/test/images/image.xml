<?xml version="1.0" encoding="UTF-8" ?>
<dds xmlns="http://www.eprosima.com">
    <profiles>
        <transport_descriptors>
            <transport_descriptor>
                <transport_id>udp_transport</transport_id>
                <type>UDPv4</type>
                <non_blocking_send>true</non_blocking_send>
                <!-- Lower buffer size for discovery purposes -->
                <sendBufferSize>100000</sendBufferSize>
                <receiveBufferSize>100000</receiveBufferSize>
            </transport_descriptor>
            <transport_descriptor>
                <transport_id>shm_transport</transport_id>
                <type>SHM</type>
                <!-- High segment size to send images locally -->
                 <segment_size>10048576</segment_size>
            </transport_descriptor>
        </transport_descriptors>

        <participant profile_name="image_participant" is_default_profile="true">
            <rtps>
                <name>image_receptor_configuration_profile</name>
                <userTransports>
                    <transport_id>udp_transport</transport_id>
                    <transport_id>shm_transport</transport_id>
                </userTransports>
                <useBuiltinTransports>false</useBuiltinTransports>

                <!-- XTypes configuration -->
                <propertiesPolicy>
                    <properties>
                        <property>
                            <name>fastdds.type_propagation</name>
                            <value>disabled</value>
                        </property>
                    </properties>
                </propertiesPolicy>
            </rtps>
        </participant>

        <!-- Only load if qos_profile is set to system_defaults -->
        <data_writer profile_name="image_writer" is_default_profile="true">
            <topic>
                <historyQos>
                    <kind>KEEP_LAST</kind>
                    <depth>5</depth>
                </historyQos>
            </topic>
            <qos>
                <reliability>
                    <kind>BEST_EFFORT</kind>
                </reliability>
                <durability>
                    <kind>VOLATILE</kind>
                </durability>
            </qos>
        </data_writer>

        <!-- Only load if qos_profile is set to system_defaults -->
        <data_reader profile_name="image_reader" is_default_profile="true">
            <topic>
                <historyQos>
                    <kind>KEEP_LAST</kind>
                    <depth>5</depth>
                </historyQos>
            </topic>
            <qos>
                <reliability>
                    <kind>BEST_EFFORT</kind>
                </reliability>
                <durability>
                    <kind>VOLATILE</kind>
                </durability>
            </qos>
        </data_reader>
    </profiles>
</dds>
