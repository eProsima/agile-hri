<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hri_emotion_detect</name>
  <version>1.0.0</version>
  <description>
      Google Mediapipe-based emotions detection for ROS4HRI
  </description>
  <author email="carlosferreira@eprosima.com">Carlos Ferreira</author>
  <maintainer email="carlosferreira@eprosima.com">Carlos Ferreira</maintainer>
  <license file="LICENSE">Apache License 2.0</license>

  <url type="website">https://www.eprosima.com/</url>

  <depend>geometry_msgs</depend>
  <depend>hri_msgs</depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
      <build_type>ament_python</build_type>
  </export>
</package>
