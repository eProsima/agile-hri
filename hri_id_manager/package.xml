<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hri_id_manager</name>
  <version>1.0.0</version>
  <description>ROS 2 node managing IDs for hri_face_detect and hri_pose_detect nodes. Part of ROS4HRI.'.</description>
  <author email="carlosferreira@eprosima.com">Carlos Ferreira</author>
  <maintainer email="carlosferreira@eprosima.com">Carlos Ferreira</maintainer>
  <license>Apache License 2.0</license>

  <url type="website">https://www.eprosima.com/</url>

  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>hri_msgs</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>rclpy</exec_depend>

  <test_depend>ament_cmake_ros</test_depend>
  <test_depend>hri_msgs</test_depend>
  <test_depend>launch_ros</test_depend>
  <test_depend>launch</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
