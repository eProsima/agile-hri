// This IDL is based on the msg done in https://github.com/ros4hri/hri_msgs/blob/humble-devel/msg/Expression.msg

// Expression.idl
// This IDL defines a Facial expression or emotion. It contains:
//   - Key annotation serving as unique identifier of the Expression. Supported only by rmw_fastrtps and Fast DDS
//   - Header for meta data
//   - Expression defined as a string to increase flexibility
//   - Confidence of the model inference

module hri_msgs {
    module msg {
        struct Expression {
            @key string key;

            std_msgs::msg::Header header;

            string expression;
            float confidence;   // from 0.0 to 1.0
        };
    };
};
