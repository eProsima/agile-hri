// Skeleton3D.idl
// This IDL defines a 3D Skeleton.
// It contains:
//   - 18 constants defining critical points in an Skeleton (same as Skeleton2D).
//   - Key annotation serving as unique identifier of the Skeleton. Supported only by rmw_fastrtps and Fast DDS
//   - Header for meta data
//   - Confidence of the inference
//   - An array containing all points defining an Skeleton
module hri_msgs {
    module msg {
        module Skeleton3D_Constants {
            // Follows OpenPose coco model convention
            // https://github.com/CMU-Perceptual-Computing-Lab/openpose/blob/master/doc/output.md#pose-output-format-coco
            const uint8 NOSE = 0;
            const uint8 NECK = 1;
            const uint8 RIGHT_SHOULDER = 2;
            const uint8 RIGHT_ELBOW = 3;
            const uint8 RIGHT_WRIST = 4;
            const uint8 LEFT_SHOULDER = 5;
            const uint8 LEFT_ELBOW = 6;
            const uint8 LEFT_WRIST = 7;
            const uint8 RIGHT_HIP = 8;
            const uint8 RIGHT_KNEE = 9;
            const uint8 RIGHT_ANKLE = 10;
            const uint8 LEFT_HIP = 11;
            const uint8 LEFT_KNEE = 12;
            const uint8 LEFT_ANKLE = 13;
            const uint8 LEFT_EYE = 14;
            const uint8 RIGHT_EYE = 15;
            const uint8 LEFT_EAR = 16;
            const uint8 RIGHT_EAR = 17;
        };

        struct Skeleton3D {
            @key string key;

            std_msgs::msg::Header header; // Header timestamp should be acquisition time of the original image
            float confidence;             // Confidence of detection of the person

            // Array of 18 skeletal key points coordinates (meters), one per skeletal key point, ordered per skeletal key points codes
            geometry_msgs::msg::Point skeleton[18];
        };
    };
};
