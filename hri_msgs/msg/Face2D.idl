// Face2D.idl
// This IDL defines a 2D Face. It serves the same purpose as FacialLandmarks but with lower
// critical points, it should be used with models providing less details after inference (e.g. YOLO).
// It contains:
//   - 5 constants defining critical points in a Face.
//   - ROS 2 keys supported by rmw_fastrtps and Fast DDS
//   - Header for meta data
//   - Confidence of the inference
//   - An array containing all points defining a Face

module hri_msgs {
    module msg {
        module Face2D_Constants {
            const uint8 RIGHT_EYE = 0;
            const uint8 LEFT_EYE = 1;
            const uint8 NOSE = 2;
            const uint8 RIGHT_MOUTH = 3;
            const uint8 LEFT_MOUTH = 4;
        };

        struct Face2D {
            @key string key;

            std_msgs::msg::Header header; // Header timestamp should be acquisition time of the original image
            float confidence;             // Confidence of detection of the face

            // Array of 5 skeletal key points coordinates, ordered per skeletal key points codes
            hri_msgs::msg::NormalizedPointOfInterest2D landmarks[5];
        };
    };
};
